          "step": {
            "question": "How imbalanced is incident volume across categories overall?",
            "why": "Establish the baseline category distribution and total denominator before checking conditional or timing-related discrepancies.",
            "columns": [
              "category"
            ],
            "check": "Compare incident_count, total_incidents, pct_total, and ratio_to_min_category; confirm total_incidents is 500 and whether one or more categories dominate unexpectedly.",
            "sql": "WITH cat_counts AS (SELECT category, COUNT(*) AS incident_count FROM source_data GROUP BY category) SELECT category, incident_count, SUM(incident_count) OVER () AS total_incidents, ROUND(100.0 * incident_count / SUM(incident_count) OVER (), 2) AS pct_total, ROUND(incident_count * 1.0 / MIN(incident_count) OVER (), 2) AS ratio_to_min_category FROM cat_counts ORDER BY incident_count DESC, category;"
